# Valores públicos exibidos em Supabase Dashboard > Project Settings > API.
# A publishable key pode ser exposta no navegador; a secret/service_role key nunca pode.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui

# URL pública da aplicação, sem barra final. Usada no retorno da confirmação de e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
